cabal-version:   3.0
name:            merecall
version:         0.1.0.0
license:
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options: -Wall

library
  import:             warnings

  -- cabal-fmt: expand src/
  exposed-modules:
    MeRecall.Relations
    MeRecall.Share
    MeRecall.Types

  hs-source-dirs:     src
  build-depends:
    , base  ^>=4.17.2.1
    , time  >=1.14

  default-extensions:
    LambdaCase
    NamedFieldPuns
    ScopedTypeVariables

  default-language:   Haskell2010

executable mrcl
  import:             warnings
  main-is:            Main.hs

  -- cabal-fmt: expand app/
  other-modules:
    Cli.Commands
    Cli.Parse
    Cli.Rendering
    Cli.Types
    Cli.Util
    Share

  build-depends:
    , base                  ^>=4.17.2.1
    , boxes
    , directory             >=1.3.8.5
    , filepath              >=1.5.2.0
    , merecall
    , optparse-applicative  >=0.18.1.0
    , process
    , split
    , temporary
    , terminal-size
    , text-ansi
    , time                  >=1.14
    , wizards

  hs-source-dirs:     app
  default-extensions:
    LambdaCase
    NamedFieldPuns
    ScopedTypeVariables

  default-language:   Haskell2010
